@startuml gui_class
title plogic - GUI

skinparam classAttributeIconSize 0
hide empty members

class GUI {
  +{static} should_launch(argv: List<OsString>): bool
  +{static} run(): Result
}

class PlogicApp {
  -input: str
  -simplify: bool
  -show_table: bool
  -show_process: bool
  -outcome: Outcome?
  -cursor: CCursorRange?
  +evaluate()
  +insert_at_cursor(ctx: &Context, text: str)
}

enum Outcome {
  Evaluations(List<Evaluation>)
  Errors(List<str>)
}

class Orchestrator

class Evaluation {
  +table: TruthTable
  +simplification: Simplification?
}

class TruthTable

class Simplification {
  +expression: Expression
  +steps: List<Step>
}

class Step {
  +rule: Rule
  +expression: Expression
}

note bottom of PlogicApp
  One vertically scrollable window. The help is a compact
  list at a smaller size. The result is a set of separate
  cards below the proposition block (formula, process,
  truth table, classification), never a fixed output box.
  Editing the formula, inserting a symbol, clearing it or
  changing Simplificar does not replace the result; only
  Evaluar does. Mostrar tabla and Mostrar proceso are
  display choices over the stored result (ADR-048).
end note

GUI ..> PlogicApp : <<create>>
PlogicApp --> Outcome
PlogicApp ..> Orchestrator : evaluate(source, simplify)
Outcome --> Evaluation
Evaluation --> TruthTable
Evaluation --> Simplification
Simplification --> Step : steps

@enduml
